{
  "name": "cloud-solution-pricing-studio-web",
  "version": "0.3.9-dev",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "python3.12 scripts/build_worker.py && node scripts/dev-server.mjs",
    "test": "python3.12 scripts/build_worker.py && python3.12 -m unittest discover -s tests -p 'test_*.py' && node --test tests/*.test.mjs",
    "build": "python3.12 scripts/build_worker.py",
    "build:offline": "python3.12 scripts/build_offline.py",
    "release:offline": "npm test && python3.12 scripts/release_offline.py"
  }
}
